# Google Gemini API key — powers the workflow planner (Gemini blueprint
# generation) and the browser_agent engine's LLM (browser-use + ChatGoogle).
GEMINI_API_KEY=

# Supabase project credentials. SUPABASE_SERVICE_ROLE_KEY is a privileged key
# used server-side only — never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Composio API key — powers the composio_api engine (1000+ app tool
# integrations) and App Vault's 1-click connect flow.
COMPOSIO_API_KEY=

# Optional integrations not required for core functionality.
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=

# Telegram API credentials (from https://my.telegram.org) — required to let
# VoxAgent log into a user's own Telegram account and automate ANY chat,
# including Saved Messages. This is an app-level credential (get it once);
# individual users then just log in with their phone number in the App
# Vault UI — no per-user dashboard visit needed. See the setup guide for the
# exact steps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Port the FastAPI/uvicorn server listens on.
PORT=8000

# Comma-separated list of origins allowed to call the API and open the
# telemetry websocket. Include your deployed frontend's origin(s) here in
# production, e.g.:
#   ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
